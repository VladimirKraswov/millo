{
  "name": "millo",
  "private": true,
  "version": "0.1.1",
  "milloRelease": {
    "channel": "alpha",
    "sequence": 2
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run test:bundle",
    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run",
    "test:brand": "node scripts/check-brand.mjs",
    "test:security": "node scripts/check-security.mjs",
    "test:release": "node scripts/check-release.mjs",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:dependencies": "npm audit --audit-level=moderate",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:site": "python3 -m unittest discover -s site/tests -v",
    "test:rust": "cargo test --workspace",
    "test": "npm run typecheck && npm run test:ui && npm run test:brand && npm run test:security && npm run test:release && npm run test:architecture && npm run test:site && npm run test:rust",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "verify": "npm test && npm run build && npm run lint:rust",
    "bundle:mac:alpha": "APPLE_SIGNING_IDENTITY=- tauri build --bundles dmg",
    "bundle:linux": "tauri build --bundles deb,appimage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
