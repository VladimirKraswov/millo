{
  "packageVersion": 1,
  "manifest": {
    "manifestVersion": 1,
    "apiVersion": 1,
    "id": "millo.operator-macros",
    "name": "Операторские макросы",
    "version": "1.0.0",
    "description": "Безопасные команды для подготовки задания и рабочего нуля.",
    "capabilities": {
      "required": ["ui.contribute", "jobs.create", "machine.jog", "machine.coordinates"],
      "optional": ["machine.read"]
    }
  },
  "commands": [
    {
      "id": "boundary-check",
      "title": "Проверить границу",
      "description": "Создаёт безопасную прямоугольную программу без шпинделя для Check или Air run.",
      "icon": "scan-line",
      "surface": "workspaceTools",
      "fields": [
        { "id": "originXMm", "label": "Начало X", "kind": "number", "defaultValue": 0, "min": -100000, "max": 100000, "step": 1, "unit": "mm" },
        { "id": "originYMm", "label": "Начало Y", "kind": "number", "defaultValue": 0, "min": -100000, "max": 100000, "step": 1, "unit": "mm" },
        { "id": "widthMm", "label": "Ширина", "kind": "number", "defaultValue": 20, "min": 0.1, "max": 100000, "step": 1, "unit": "mm" },
        { "id": "heightMm", "label": "Высота", "kind": "number", "defaultValue": 20, "min": 0.1, "max": 100000, "step": 1, "unit": "mm" },
        { "id": "safeZMm", "label": "Безопасная Z", "kind": "number", "defaultValue": 3, "min": 0, "max": 10000, "step": 0.5, "unit": "mm" },
        { "id": "feedMmPerMin", "label": "Подача", "kind": "number", "defaultValue": 300, "min": 10, "max": 100000, "step": 10, "unit": "mm/min" }
      ],
      "requiredCapabilities": ["jobs.create"]
    },
    {
      "id": "raise-z",
      "title": "Поднять Z",
      "description": "Поднимает фрезу одним защищённым jog-действием.",
      "icon": "arrow-up-from-line",
      "surface": "machinePanel",
      "fields": [
        { "id": "distanceMm", "label": "Подъём", "kind": "number", "defaultValue": 5, "min": 0.01, "max": 50, "step": 0.1, "unit": "mm" },
        { "id": "feedMmPerMin", "label": "Подача", "kind": "number", "defaultValue": 300, "min": 10, "max": 100000, "step": 10, "unit": "mm/min" }
      ],
      "requiredCapabilities": ["machine.jog"]
    },
    {
      "id": "return-z-zero",
      "title": "Вернуть Z в ноль",
      "description": "Возвращает Z к текущему рабочему нулю через типизированную команду ядра.",
      "icon": "locate-fixed",
      "surface": "machinePanel",
      "fields": [
        { "id": "feedMmPerMin", "label": "Подача", "kind": "number", "defaultValue": 100, "min": 10, "max": 100000, "step": 10, "unit": "mm/min" }
      ],
      "requiredCapabilities": ["machine.coordinates"]
    },
    {
      "id": "set-z-zero",
      "title": "Z0 здесь",
      "description": "Записывает текущую позицию как рабочий Z0 и проверяет её через $#.",
      "icon": "crosshair",
      "surface": "machinePanel",
      "fields": [],
      "requiredCapabilities": ["machine.coordinates"]
    }
  ],
  "source": "fn run(command, input, machine) {\n  if command == \"boundary-check\" {\n    let ox = input.originXMm;\n    let oy = input.originYMm;\n    let w = input.widthMm;\n    let h = input.heightMm;\n    let z = input.safeZMm;\n    let f = input.feedMmPerMin;\n    let name = \"boundary-check-\" + w.to_string() + \"x\" + h.to_string() + \".nc\";\n    let source = \"(Millo boundary check: spindle and coolant remain off)\\nG21 G90 G94 G17\\nM5\\nM9\\nG0 Z\" + z + \"\\nG0 X\" + ox + \" Y\" + oy + \"\\nG1 X\" + (ox + w) + \" Y\" + oy + \" F\" + f + \"\\nG1 X\" + (ox + w) + \" Y\" + (oy + h) + \"\\nG1 X\" + ox + \" Y\" + (oy + h) + \"\\nG1 X\" + ox + \" Y\" + oy + \"\\nG0 Z\" + z + \"\\nM2\\n\";\n    return #{ kind: \"createProgram\", sourceName: name, source: source };\n  }\n  if command == \"raise-z\" {\n    return #{ kind: \"jog\", axis: \"z\", distanceMm: input.distanceMm, feedMmPerMin: input.feedMmPerMin };\n  }\n  if command == \"return-z-zero\" {\n    return #{ kind: \"returnZero\", axis: \"z\", feedMmPerMin: input.feedMmPerMin };\n  }\n  if command == \"set-z-zero\" {\n    return #{ kind: \"setZero\", axis: \"z\" };\n  }\n  return #{ kind: \"notice\", title: \"Неизвестная команда\", message: command, tone: \"warning\" };\n}"
}
