[Unit]
Description=Millo project website and feedback API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=millo-site
Group=millo-site
WorkingDirectory=/opt/millo-site
EnvironmentFile=/etc/millo-site.env
ExecStart=/usr/bin/python3 /opt/millo-site/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/millo-site
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
